# App
APP_ENV=dev
APP_LOG_LEVEL=INFO

# Vault (set VAULT_ENABLED=true in production; secrets are fetched at startup)
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_AUTH_METHOD=approle
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_MOUNT_POINT=secret
VAULT_BASE_PATH=asr-system

# Shared database
DB_DSN=sqlite:///./data/asr.db

# Batch storage and paths
BATCH_INPUT_DIR=./data/input
BATCH_OUTPUT_DIR=./data/output
BATCH_STORAGE_ACCESS_KEY=
BATCH_STORAGE_SECRET_KEY=

# Batch model providers (use mock/rule for local dev; whisper/rubert for production)
BATCH_ASR_PROVIDER=mock
BATCH_ASR_MODEL=whisper-large-v3-turbo
BATCH_EMOTION_PROVIDER=rule
BATCH_EMOTION_MODEL=cointegrated/rubert-tiny2

# Batch orchestration
BATCH_AIRFLOW_SCHEDULE=0 0 * * *
BATCH_AIRFLOW_SLA_HOUR_MSK=8

# Online service
ONLINE_API_HOST=0.0.0.0
ONLINE_API_PORT=8080
ONLINE_API_TOKEN=
